# Base de datos (SQLite para desarrollo; cambia a Postgres en producción)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="reemplaza-esto-con-un-valor-aleatorio-seguro"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI (opcional). Sin esta clave, la IA usa un motor local de reglas
# sobre el catálogo, así el sistema es 100% funcional en modo demo.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Dominio público usado para generar enlaces de catálogo, QR y NFC
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
